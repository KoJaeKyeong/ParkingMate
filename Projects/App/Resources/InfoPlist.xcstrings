    },
    "NSCameraUsageDescription" : {
      "comment" : "카메라 권한 설명",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is needed to record your parking spot with a photo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주차 위치를 사진으로 기록하기 위해 카메라 권한이 필요합니다."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "항상 위치 권한 설명",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always-on location access is needed to accurately record your parking spot, even in the background."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드에서도 주차 위치를 정확하게 기록하기 위해 항상 위치 권한이 필요합니다."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "사용 중 위치 권한 설명",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is needed to automatically save where you parked."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주차한 위치를 자동으로 저장하기 위해 위치 권한이 필요합니다."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "마이크 권한 설명",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone access is needed so you can enter your parking spot by voice."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주차 위치를 음성으로 입력하기 위해 마이크 권한이 필요합니다."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "음성 인식 권한 설명",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech recognition is needed to convert your voice into text and record your parking spot."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성을 텍스트로 변환하여 주차 위치를 기록하기 위해 음성 인식 권한이 필요합니다."
          }
        }
      }
    }
  },
  "version" : "1.0"
}